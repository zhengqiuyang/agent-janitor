{
  "name": "agent-janitor",
  "version": "0.1.0",
  "description": "The janitor must not be an agent — deterministic cleanup of plan docs & scratch scripts left by AI coding agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-janitor": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node run-tests.mjs",
    "demo": "node scripts/demo.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ai-agents",
    "developer-tools",
    "cli",
    "git",
    "housekeeping"
  ],
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengqiuyang/agent-janitor.git"
  }
}
